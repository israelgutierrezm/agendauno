APP_NAME=AgendaUno
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es_MX
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database: dedicated schema on local WAMP MySQL (3306) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=agendauno
DB_USERNAME=root
DB_PASSWORD=

# --- Sessions / Cache / Queue ---
# Bootable defaults use MySQL so the app runs even when Redis/Docker is down.
# To use Redis: `docker compose -f infra/docker/docker-compose.yml up -d redis`
# then set SESSION_DRIVER / CACHE_STORE / QUEUE_CONNECTION to `redis`.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Redis (predis = pure PHP client, no native extension needed on Windows) ---
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Fail fast on the health probe when Redis is down (raise once Redis is the primary store).
REDIS_MAX_RETRIES=1

# Flujo multi-tenant (apps/web :5175). Auth por bearer, no stateful.
FRONTEND_URL=http://localhost:5175

# Google Sign-In (SSO tenant-local). Client ID web de Google Identity Services;
# valida el `aud` del ID token. Debe coincidir con VITE_GOOGLE_CLIENT_ID del front.
GOOGLE_CLIENT_ID=

# Dominio base para resolver el estudio por subdominio ({slug}.agendauno.mx). Las
# rutas del tenant se sirven ademas bajo este dominio (aparte de /app/{estudio}).
APP_TENANT_DOMAIN=agendauno.mx

# --- Correo ---
# En desarrollo `log` deja los correos en storage/logs. En producción usa SMTP con
# tu proveedor (Resend, Postmark, Amazon SES, Brevo, Google Workspace…):
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.tu-proveedor.com
#   MAIL_PORT=587
#   MAIL_USERNAME=usuario
#   MAIL_PASSWORD=contraseña-o-llave
#   MAIL_SCHEME=smtp        (587 con STARTTLS; usa smtps para el 465)
# El remitente debe ser de un dominio verificado en el proveedor (SPF + DKIM). Los
# correos de cada negocio salen con su nombre y esta dirección, y las respuestas
# llegan a su correo de contacto. Comprueba con: php artisan agendauno:probar-correo tu@correo.com
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM_ADDRESS="no-reply@agendauno.mx"
MAIL_FROM_NAME="AgendaUno"

# --- S3-compatible object storage (configure when Media module starts) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Notificaciones push (Firebase Cloud Messaging): ruta al JSON de la cuenta de servicio
# del proyecto de Firebase de la app (Configuración del proyecto → Cuentas de servicio →
# Generar nueva clave privada). Guárdalo fuera del repositorio. Sin él no se envían push.
FCM_CREDENTIALS=
FCM_PROJECT_ID=

# WhatsApp (Meta Cloud API): el número y el token se cargan desde el panel del
# superadministrador. Aquí solo la versión de la Graph API y la lada por omisión.
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_LADA=52

# Facturacion CFDI (FacturAPI): llave maestra de la cuenta de plataforma.
FACTURAPI_LLAVE=
# PlatformAdmin: token del operador de plataforma (habilita /api/v1/plataforma/*).
PLATFORM_ADMIN_TOKEN=
