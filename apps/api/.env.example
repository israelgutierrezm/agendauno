APP_NAME=TurnoUno
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

APP_LOCALE=es_MX
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database: dedicated schema on local WAMP MySQL (3306) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=turnouno
DB_USERNAME=root
DB_PASSWORD=

# --- Sessions / Cache / Queue ---
# Bootable defaults use MySQL so the app runs even when Redis/Docker is down.
# To use Redis: `docker compose -f infra/docker/docker-compose.yml up -d redis`
# then set SESSION_DRIVER / CACHE_STORE / QUEUE_CONNECTION to `redis`.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Redis (predis = pure PHP client, no native extension needed on Windows) ---
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Fail fast on the health probe when Redis is down (raise once Redis is the primary store).
REDIS_MAX_RETRIES=1

# Flujo multi-tenant (registro-web :5175). Auth por bearer, no stateful.
FRONTEND_REGISTRO_URL=http://localhost:5175

# Google Sign-In (SSO tenant-local). Client ID web de Google Identity Services;
# valida el `aud` del ID token. Debe coincidir con VITE_GOOGLE_CLIENT_ID del front.
GOOGLE_CLIENT_ID=

# Dominio base para resolver el estudio por subdominio ({slug}.turnouno.com). Las
# rutas del tenant se sirven ademas bajo este dominio (aparte de /app/{estudio}).
APP_TENANT_DOMAIN=turnouno.com

# --- Mail (log driver in dev; point to mailpit when Communications starts) ---
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM_ADDRESS="no-reply@turnouno.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- S3-compatible object storage (configure when Media module starts) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Facturacion CFDI (FacturAPI): llave maestra de la cuenta de plataforma.
FACTURAPI_LLAVE=
# PlatformAdmin: token del operador de plataforma (habilita /api/v1/plataforma/*).
PLATFORM_ADMIN_TOKEN=
