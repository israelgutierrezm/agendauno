# URL base de la API (por defecto http://localhost:8000).
VITE_API_URL=http://localhost:8000
# Opcional: endpoint first-party que recibe eventos JSON de conversión sin datos personales.
VITE_ANALYTICS_ENDPOINT=

# Token público de verificación HTML de Search Console (opcional, sin etiquetas).
# Solo se añade al HTML comercial durante npm run build. No es una contraseña.
GOOGLE_SITE_VERIFICATION=

# Google Sign-In (SSO tenant-local). Client ID web de Google Identity Services.
# Debe coincidir con GOOGLE_CLIENT_ID de la API. Si se deja vacio, el boton de
# Google muestra un aviso de "proximamente" en lugar de activarse.
VITE_GOOGLE_CLIENT_ID=

# Dominio público: cada negocio vive en {slug}.<dominio> (por defecto agendauno.mx).
# En producción lo pone el compose desde DOMINIO de web.env. No lo dejes vacío.
# VITE_DOMINIO_PUBLICO=agendauno.mx

# reCAPTCHA v3 del registro de negocios (site key pública). Vacío: solo el campo
# trampa contra bots. La API valida con RECAPTCHA_SECRET.
VITE_RECAPTCHA_SITE_KEY=
