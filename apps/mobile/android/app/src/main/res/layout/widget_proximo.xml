<?xml version="1.0" encoding="utf-8"?>
<!-- El widget de inicio del cliente (WidgetProximo.kt): el negocio, su próxima
     reserva o cita (qué, cuándo y dónde), si falta pagarla (punto + texto) y su
     saldo. Solo vistas que admite RemoteViews. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fondo"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_negocio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/widget_texto_suave"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_etiqueta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:text="@string/widget_proximo_etiqueta"
        android:textColor="@color/widget_texto_suave"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_titulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="@string/widget_proximo_sin_sesion"
        android:textColor="@color/widget_texto"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_cuando"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/widget_texto"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_aviso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_punto_aviso" />

        <TextView
            android:id="@+id/widget_aviso_texto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="@color/widget_aviso"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_plan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/widget_texto_suave"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
