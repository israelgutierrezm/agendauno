{
  "name": "registro-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && node scripts/build-marketing.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:marketing": "node scripts/check-marketing.mjs && node scripts/check-marketing-http.mjs",
    "test:watch": "vitest",
    "typecheck": "vue-tsc -b",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,vue,css,json}\""
  },
  "dependencies": {
    "axios": "^1.20.0",
    "pinia": "^4.0.3",
    "qrcode": "^1.5.4",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.10",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^16.5.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  }
}
