# === AgendaUno · web en producción ===
# Copia a web.env (no lo subas al repositorio). Se usa como --env-file del compose:
# lo público va dentro del JavaScript al compilar; nada de aquí es secreto.

# Dominio comercial; cada negocio vive en {slug}.DOMINIO. Igual que APP_TENANT_DOMAIN.
DOMINIO=agendauno.mx

# Red desde la que llega el proxy que termina TLS (confía en su X-Forwarded-For).
# Con el puerto publicado en 127.0.0.1:8080, es la red de Docker.
PROXY_CONFIABLE=172.16.0.0/12

# reCAPTCHA v3 del registro público: obligatorio en producción (su secreto va en
# api.env, RECAPTCHA_SECRET).
VITE_RECAPTCHA_SITE_KEY=

# Opcionales.
# WhatsApp de ventas para cotizaciones en la página de precios (solo dígitos, con lada).
VITE_VENTAS_WHATSAPP=
VITE_GOOGLE_CLIENT_ID=
VITE_ANALYTICS_ENDPOINT=
# Token público de verificación de Search Console (solo el valor).
GOOGLE_SITE_VERIFICATION=
