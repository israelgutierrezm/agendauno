# === AgendaUno · web en producción ===
# Copia a web.env (no lo subas al repositorio). Se usa como --env-file del compose:
# lo público va dentro del JavaScript al compilar; nada de aquí es secreto.

# Dominios de los productos (ADR 0108). AgendaUno: cada negocio de clases vive en
# {slug}.DOMINIO (igual que APP_TENANT_DOMAIN). TurnoUno: los de citas, en
# {slug}.DOMINIO_TURNOUNO (igual que TURNOUNO_DOMINIO).
DOMINIO=agendauno.mx
DOMINIO_TURNOUNO=turnouno.mx
# Nombre de TurnoUno mientras no tenga identidad definitiva (opcional).
VITE_TURNOUNO_NOMBRE=

# Red desde la que llega el proxy que termina TLS (confía en sus cabeceras). Con el
# puerto publicado en 127.0.0.1:8080, la red de Docker; detrás de Traefik, la subred de
# su red (docker network inspect TRAEFIK_RED).
PROXY_CONFIABLE=172.16.0.0/12

# Detrás del Traefik del servidor (ADR 0112): descomenta COMPOSE_FILE. Con el proxy de
# Cloudflare (nube naranja), agrega también docker-compose.cloudflare.yml al final.
#COMPOSE_FILE=docker-compose.yml:docker-compose.traefik.yml
#COMPOSE_FILE=docker-compose.yml:docker-compose.traefik.yml:docker-compose.cloudflare.yml
# La red de Traefik, su punto de entrada HTTPS y su resolvedor de certificados por DNS-01
# con Cloudflare (los del Traefik existente; docs/DESPLIEGUE.md → «Traefik»).
TRAEFIK_RED=traefik
TRAEFIK_ENTRADA=websecure
TRAEFIK_CERTRESOLVER=cloudflare

# Imágenes publicadas por el CI (flujo «Imágenes», ADR 0113): con REGISTRO, actualizar.sh
# las baja de ahí (antes: docker login ghcr.io con un token de solo lectura) en lugar de
# construirlas en el servidor. Vacío: se construyen aquí, como siempre.
#REGISTRO=ghcr.io/israelgutierrezm

# reCAPTCHA v3 del registro público: obligatorio en producción (su secreto va en
# api.env, RECAPTCHA_SECRET).
VITE_RECAPTCHA_SITE_KEY=

# Opcionales.
# WhatsApp de ventas para cotizaciones en la página de precios (solo dígitos, con lada).
VITE_VENTAS_WHATSAPP=
VITE_GOOGLE_CLIENT_ID=
VITE_ANALYTICS_ENDPOINT=
# Token público de verificación de Search Console (solo el valor).
GOOGLE_SITE_VERIFICATION=
