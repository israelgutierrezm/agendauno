# === AgendaUno · API en producción ===
# Copia a api.env (no lo subas al repositorio) y llénalo. Guía: docs/DESPLIEGUE.md.

APP_NAME=AgendaUno
APP_ENV=production
APP_DEBUG=false
# Genérala UNA sola vez:  docker compose run --rm --no-deps api php artisan key:generate --show
# y no la cambies nunca: cifra las llaves de las pasarelas de cada negocio y firma
# los pases QR. Si se pierde, esas llaves ya no se pueden leer.
APP_KEY=
APP_URL=https://agendauno.mx
APP_LOCALE=es_MX
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

# Dominio de los negocios ({slug}.agendauno.mx). Debe ser el mismo DOMINIO de web.env.
APP_TENANT_DOMAIN=agendauno.mx
# A dónde llevan los enlaces de los correos (activar cuenta, confirmar, recuperar).
APP_SPA_URL=https://agendauno.mx
# Orígenes de la web que pueden llamar a la API desde el navegador (CORS), separados
# por comas.
FRONTEND_URL=https://agendauno.mx

# Logs a la salida del contenedor (docker compose logs).
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- MySQL ---
# Control plane (negocios, planes, cobro del SaaS).
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=agendauno
DB_USERNAME=agendauno
DB_PASSWORD=
# Una base por negocio (tenant_{slug}_{azar}) en el mismo servidor. El usuario
# necesita poder crearlas: GRANT ALL ON `tenant\_%`.* TO 'agendauno'@'%';
TENANT_DB_DRIVER=mysql
# Solo si las bases de los negocios van en otro servidor:
# TENANT_DB_HOST=
# TENANT_DB_PORT=3306
# TENANT_DB_USERNAME=
# TENANT_DB_PASSWORD=

# --- Redis (servicio redis del compose) ---
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# --- Archivos ---
# Documentos, fotos y logos van al volumen `storage` (discos `local` y `public`),
# no a S3: respáldalo. S3 se usa para los respaldos (variables AWS_* de abajo).
FILESYSTEM_DISK=local

# --- Correo (SMTP de tu proveedor: Resend, Postmark, Amazon SES, Brevo…) ---
# El remitente debe ser de un dominio verificado (SPF + DKIM).
# Prueba:  docker compose exec api php artisan agendauno:probar-correo tu@correo.com
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# smtp = 587 con STARTTLS; smtps = 465.
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS="no-reply@agendauno.mx"
MAIL_FROM_NAME="AgendaUno"

# --- Plataforma (superadmin) ---
# Token largo y aleatorio: habilita /api/v1/plataforma/* (openssl rand -hex 32).
PLATFORM_ADMIN_TOKEN=
# Quién recibe las alertas de la plataforma (pagos, correos, respaldos o cola que
# fallan, rentas vencidas), agrupadas por correo. El superadmin puede capturar otro
# en Configuración, que tiene prioridad; este queda de respaldo.
ALERTAS_CORREO=

# ¿Ya se cobra la renta del SaaS con dinero real? Con true, la verificación de
# producción exige Stripe de la plataforma en modo live (llaves sk_live_). Déjalo en
# false en una instalación de prueba.
APERTURA_COMERCIAL=false

# --- Opcionales ---
# Entrar con Google: Client ID web (el mismo VITE_GOOGLE_CLIENT_ID de web.env).
GOOGLE_CLIENT_ID=
# reCAPTCHA v3 en registros públicos.
RECAPTCHA_SECRET=
RECAPTCHA_MIN_SCORE=0.5
# Facturación CFDI (FacturAPI): llave maestra de la cuenta de plataforma.
FACTURAPI_LLAVE=
# Notificaciones push (Firebase): JSON de la cuenta de servicio dentro del volumen
# storage (no en la imagen), p. ej. storage/credenciales/fcm.json.
FCM_PROJECT_ID=
FCM_CREDENTIALS=
# WhatsApp (Meta Cloud API): se enciende y se cargan número y token en el panel del
# superadministrador. Aquí solo la versión de la Graph API y la lada por omisión.
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_LADA=52
# --- Respaldos (fuera del servidor) ---
# Diarios: base central y archivos subidos (03:05) y la base de cada negocio (03:15),
# con su suma sha256; simulacro de restauración los domingos. Van a un almacenamiento
# compatible con S3 FUERA del VPS (Cloudflare R2, Backblaze B2, AWS S3…). Crea un
# bucket privado solo para esto y una llave con permiso de leer y escribir en él.
RESPALDOS_DISCO=s3
RESPALDOS_DIAS=14
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
# R2: https://<cuenta>.r2.cloudflarestorage.com · B2: https://s3.<región>.backblazeb2.com
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true
