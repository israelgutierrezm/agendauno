# === AgendaUno · API en producción ===
# Copia a api.env (no lo subas al repositorio) y llénalo. Guía: docs/DESPLIEGUE.md.

APP_NAME=AgendaUno
APP_ENV=production
APP_DEBUG=false
# Genérala UNA sola vez (el arranque normal se niega a correr sin ella):
#   docker compose --env-file web.env run --rm --no-deps --entrypoint php api artisan key:generate --show
# y no la cambies nunca: cifra las llaves de las pasarelas de cada negocio y firma
# los pases QR. Si se pierde, esas llaves ya no se pueden leer.
APP_KEY=
APP_URL=https://agendauno.mx
APP_LOCALE=es_MX
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

# --- Productos (ADR 0108): AgendaUno (clases) y TurnoUno (citas) ---
# AgendaUno: dominio de sus negocios ({slug}.agendauno.mx) y web a la que llevan los
# enlaces de sus correos (activar cuenta, confirmar, recuperar).
APP_TENANT_DOMAIN=agendauno.mx
APP_SPA_URL=https://agendauno.mx
# TurnoUno: lo mismo para los negocios de citas ({slug}.turnouno.mx).
TURNOUNO_DOMINIO=turnouno.mx
TURNOUNO_URL_WEB=https://turnouno.mx
# Remitente de los correos de cada producto (opcional; sin él, MAIL_FROM_ADDRESS). El
# dominio del remitente debe estar verificado (SPF y DKIM) en el proveedor de correo.
AGENDAUNO_MAIL_FROM=
TURNOUNO_MAIL_FROM=
# Orígenes de la web que pueden llamar a la API desde el navegador (CORS), separados
# por comas. Los dos dominios y sus subdominios ya se admiten solos.
FRONTEND_URL=https://agendauno.mx,https://turnouno.mx
# Versión más antigua de la app móvil que aún se acepta (viaja en /yo). Súbela cuando
# un cambio de la API ya no lo entiendan las versiones instaladas: la app pide
# actualizarse. 0.0.0 = todas.
APP_VERSION_MINIMA_APP=0.0.0

# Logs a la salida del contenedor (docker compose logs).
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- MySQL ---
# Control plane (negocios, planes, cobro del SaaS).
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=agendauno
DB_USERNAME=agendauno
DB_PASSWORD=
# Una base por negocio (tenant_{slug}_{azar}) en el mismo servidor. El usuario
# necesita poder crearlas: GRANT ALL ON `tenant\_%`.* TO 'agendauno'@'%';
TENANT_DB_DRIVER=mysql
# Solo si las bases de los negocios van en otro servidor:
# TENANT_DB_HOST=
# TENANT_DB_PORT=3306
# TENANT_DB_USERNAME=
# TENANT_DB_PASSWORD=
# TENANT_MYSQL_ATTR_SSL_CA=
# TLS hacia MySQL: solo si el servidor lo exige (un servicio administrado). La CA
# del proveedor, como archivo dentro del volumen storage (ruta absoluta, p. ej.
# /var/www/html/storage/credenciales/mysql-ca.pem). Con ella la API cifra y
# verifica el servidor, en la base central y en las de los negocios, y los
# respaldos la usan también. En la red privada de Docker déjala vacía.
MYSQL_ATTR_SSL_CA=

# --- Redis (servicio redis del compose) ---
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# --- Archivos ---
# Documentos, fotos y logos van al volumen `storage` (discos `local` y `public`),
# no a S3: respáldalo. S3 se usa para los respaldos (variables AWS_* de abajo).
FILESYSTEM_DISK=local

# --- Correo (SMTP de tu proveedor: Resend, Postmark, Amazon SES, Brevo…) ---
# El remitente debe ser de un dominio verificado (SPF + DKIM).
# Prueba:  docker compose --env-file web.env exec -u www-data api php artisan agendauno:probar-correo tu@correo.com
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# smtp = 587 con STARTTLS; smtps = 465.
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS="no-reply@agendauno.mx"
MAIL_FROM_NAME="AgendaUno"

# --- Plataforma (superadmin) ---
# Token largo y aleatorio: habilita /api/v1/plataforma/* (openssl rand -hex 32).
PLATFORM_ADMIN_TOKEN=
# Quién recibe las alertas de la plataforma (pagos, correos, respaldos o cola que
# fallan, rentas vencidas), agrupadas por correo. El superadmin puede capturar otro
# en Configuración, que tiene prioridad; este queda de respaldo.
ALERTAS_CORREO=

# ¿Ya se cobra la renta del SaaS con dinero real? Con true, la verificación de
# producción exige Stripe de la plataforma en modo live (llaves sk_live_). Déjalo en
# false en una instalación de prueba.
APERTURA_COMERCIAL=false

# --- reCAPTCHA v3 del registro público (obligatorio en producción) ---
# Cada alta crea una base completa y manda un correo: sin captcha, un bot llena el
# servidor. Sin la llave, en producción se rechazan el registro y la lista de
# interesados, y `agendauno:verificar-produccion` no da la plataforma por lista. La
# llave del sitio va en web.env (VITE_RECAPTCHA_SITE_KEY).
RECAPTCHA_SECRET=
RECAPTCHA_MIN_SCORE=0.5

# --- Opcionales ---
# Entrar con Google: Client ID web (el mismo VITE_GOOGLE_CLIENT_ID de web.env).
GOOGLE_CLIENT_ID=
# Entrar con Google desde la app móvil: los Client ID de Android e iOS, separados por
# coma (ver docs/GOOGLE_APP.md). Sin ellos, Google en la app no funciona.
GOOGLE_CLIENT_IDS_APP=
# Facturación CFDI (FacturAPI): llave maestra de la cuenta de plataforma.
FACTURAPI_LLAVE=
# Tipo de cambio FIX del Banco de México (ADR 0107): con él se cobra en pesos a los
# negocios de México la renta publicada en dólares. Token gratis en
# https://www.banxico.org.mx/SieAPIRest/service/v1/token. Sin él, el superadmin
# captura el tipo de cambio en su panel.
BANXICO_TOKEN=
# Cotizaciones (más de 20 profesionales o 1,000 alumnos): correo y WhatsApp de ventas.
VENTAS_CORREO=ventas@agendauno.mx
VENTAS_WHATSAPP=
# Correo de ventas propio de TurnoUno (opcional; sin él, VENTAS_CORREO). El superadmin
# también lo captura en Datos comerciales.
TURNOUNO_VENTAS_CORREO=
# Notificaciones push (Firebase): JSON de la cuenta de servicio dentro del volumen
# storage (no en la imagen), p. ej. storage/credenciales/fcm.json.
FCM_PROJECT_ID=
FCM_CREDENTIALS=
# WhatsApp (Meta Cloud API): se enciende y se cargan número y token en el panel del
# superadministrador. Aquí solo la versión de la Graph API y la lada por omisión.
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_LADA=52
# --- Respaldos (fuera del servidor) ---
# Diarios: base central y archivos subidos (03:05) y la base de cada negocio (03:15),
# con su suma sha256; simulacro de restauración los domingos. Van a un almacenamiento
# compatible con S3 FUERA del VPS (Cloudflare R2, Backblaze B2, AWS S3…). Crea un
# bucket privado solo para esto y una llave con permiso de leer y escribir en él.
RESPALDOS_DISCO=s3
RESPALDOS_DIAS=14
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
# R2: https://<cuenta>.r2.cloudflarestorage.com · B2: https://s3.<región>.backblazeb2.com
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true
# mysqldump y mysql de la imagen son los de MariaDB: cifran con TLS y verifican el
# certificado del servidor. El que genera MySQL 8 es autofirmado, así que en la red
# privada de Docker no se verifica (la conexión sigue cifrada). Si MySQL va por
# internet o es un servicio administrado, pon true: se verifica con la CA de
# MYSQL_ATTR_SSL_CA, o con RESPALDOS_MYSQL_SSL_CA si los respaldos usan otra.
RESPALDOS_MYSQL_SSL_VERIFICAR=false
# RESPALDOS_MYSQL_SSL_CA=
# Otras opciones para mysqldump y mysql, separadas por espacios. Con el cliente de
# Oracle MySQL (no entiende la de arriba en false): RESPALDOS_MYSQL_SSL_VERIFICAR=true
# y RESPALDOS_MYSQL_OPCIONES=--ssl-mode=REQUIRED
# RESPALDOS_MYSQL_OPCIONES=
