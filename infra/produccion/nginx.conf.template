# nginx de AgendaUno en producción. Plantilla: al arrancar, la imagen oficial de nginx
# sustituye ${DOMINIO} y ${PROXY_CONFIABLE} y deja el resultado en conf.d/.
#
# Escucha HTTP detrás del proxy que termina TLS (Caddy, Cloudflare, el balanceador
# del proveedor). Ese proxy debe ser lo único que lo alcanza: aquí se confía en sus
# cabeceras X-Forwarded-*.

# IP real del cliente: los límites por IP de la API dependen de ella.
set_real_ip_from ${PROXY_CONFIABLE};
real_ip_header X-Forwarded-For;
real_ip_recursive on;

# La API se entera de que la petición llegó por HTTPS (para armar sus URLs).
map $http_x_forwarded_proto $https_cliente {
    https on;
    default "";
}

upstream agendauno_php {
    server api:9000;
}

server_tokens off;
client_max_body_size 22m;

# www → dominio canónico.
server {
    listen 80;
    server_name www.${DOMINIO};
    return 301 https://${DOMINIO}$request_uri;
}

# Dominio comercial: la portada y cada página con HTML propio (por giro, registro,
# acceso…) se sirven tal cual; lo demás es la aplicación (app.html), nunca la
# portada como respaldo universal.
server {
    listen 80;
    server_name ${DOMINIO};
    root /usr/share/nginx/html;
    include /etc/nginx/snippets/agendauno-comun.conf;

    location = / {
        try_files /index.html =404;
    }
    location / {
        try_files $uri/index.html $uri /app.html;
    }
}

# Subdominio de cada negocio ({slug}.dominio) y cualquier otro host: siempre la
# aplicación, también en "/". La API resuelve el negocio por el subdominio.
server {
    listen 80 default_server;
    server_name *.${DOMINIO} _;
    root /usr/share/nginx/html;
    include /etc/nginx/snippets/agendauno-comun.conf;

    location / {
        try_files /app.html =404;
    }
}
