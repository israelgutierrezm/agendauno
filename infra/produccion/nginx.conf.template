# nginx de la plataforma en producción (ADR 0108: AgendaUno y TurnoUno). Plantilla: al
# arrancar, la imagen oficial de nginx sustituye ${DOMINIO} (AgendaUno),
# ${DOMINIO_TURNOUNO}, ${PROXY_CONFIABLE} y ${CABECERA_IP_REAL} y deja el resultado en
# conf.d/.
#
# Escucha HTTP detrás del proxy que termina TLS (Traefik, Cloudflare, el balanceador
# del proveedor). Ese proxy debe ser lo único que lo alcanza: aquí se confía en sus
# cabeceras.
#
# Sirve la aplicación (/usr/share/nginx/html/app: panel, portal, escaparate de cada
# negocio, registro, acceso, superadmin) y pasa la portada, las páginas por giro, el
# sitemap, el robots y /assets-{producto}/ a la landing de cada producto, que es otro
# contenedor (landing-agendauno, landing-turnouno; ADR 0112): cada landing se publica
# sin tocar la aplicación ni la API.

# IP real del cliente: los límites por IP de la API dependen de ella. La cabecera es
# X-Forwarded-For (el proxy pone la IP de quien se conectó) o, detrás del proxy de
# Cloudflare, CF-Connecting-IP (docker-compose.cloudflare.yml, que además solo deja
# entrar a Cloudflare: nadie más puede inventarla).
set_real_ip_from ${PROXY_CONFIABLE};
real_ip_header ${CABECERA_IP_REAL};
real_ip_recursive on;

# La API se entera de que la petición llegó por HTTPS (para armar sus URLs).
map $http_x_forwarded_proto $https_cliente {
    https on;
    default "";
}

# Marcos (cabeceras de nginx-cabeceras.conf): DENY en todo, salvo la vista previa del
# sitio de un negocio (/estudio/{slug}/vista-previa), que el panel muestra en un iframe
# del mismo origen (ADR 0114). Con $request_uri: tras try_files, $uri ya es /app.html.
map $request_uri $marco {
    ~^/estudio/[a-z0-9-]+/vista-previa/?(\?.*)?$ SAMEORIGIN;
    default DENY;
}
map $request_uri $marco_csp {
    ~^/estudio/[a-z0-9-]+/vista-previa/?(\?.*)?$ "frame-ancestors 'self'";
    default "frame-ancestors 'none'";
}

# PHP-FPM (servicio api): ver nginx-comun.conf (se resuelve con el DNS de Docker en
# cada petición, no una sola vez al arrancar).

server_tokens off;
client_max_body_size 22m;

# www → dominio canónico de cada producto.
server {
    listen 80;
    server_name www.${DOMINIO};
    include /etc/nginx/snippets/agendauno-cabeceras.conf;
    return 301 https://${DOMINIO}$request_uri;
}
server {
    listen 80;
    server_name www.${DOMINIO_TURNOUNO};
    include /etc/nginx/snippets/agendauno-cabeceras.conf;
    return 301 https://${DOMINIO_TURNOUNO}$request_uri;
}

# Dominio de AgendaUno: su landing (portada, páginas por giro, sitemap, robots) y lo
# demás (registro, entrar, panel…) la aplicación, nunca la portada como respaldo.
server {
    listen 80;
    server_name ${DOMINIO};
    root /usr/share/nginx/html/app;
    include /etc/nginx/snippets/agendauno-comun.conf;
    set $landing landing-agendauno:80;

    # La landing (otro contenedor; la caché del HTML la decide ella). Una página que
    # no tenga, o si no responde, la aplicación.
    location = / {
        include /etc/nginx/snippets/agendauno-landing-proxy.conf;
        proxy_intercept_errors on;
        error_page 404 502 503 504 = @aplicacion;
    }
    location ~ ^/software-para-[a-z0-9-]+/?$ {
        include /etc/nginx/snippets/agendauno-landing-proxy.conf;
        proxy_intercept_errors on;
        error_page 404 502 503 504 = @aplicacion;
    }
    # Exactos: ganan a la regla de archivos de nginx-comun.conf.
    location = /sitemap.xml {
        include /etc/nginx/snippets/agendauno-landing-proxy.conf;
    }
    location = /robots.txt {
        include /etc/nginx/snippets/agendauno-landing-proxy.conf;
    }
    location ^~ /assets-agendauno/ {
        include /etc/nginx/snippets/agendauno-landing-proxy.conf;
    }

    # La aplicación. El HTML se revalida siempre (no-cache): tras publicar, el
    # navegador no debe usar uno viejo que apunte a recursos que ya no existen. Al
    # tener add_header propio, cada location repite las cabeceras de seguridad.
    location @aplicacion {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/agendauno-cabeceras.conf;
        try_files /app.html =404;
    }
    location / {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/agendauno-cabeceras.conf;
        try_files $uri /app.html;
    }
}

# Dominio de TurnoUno: igual, con su landing.
server {
    listen 80;
    server_name ${DOMINIO_TURNOUNO};
    root /usr/share/nginx/html/app;
    include /etc/nginx/snippets/agendauno-comun.conf;
    set $landing landing-turnouno:80;

    location = / {
        include /etc/nginx/snippets/agendauno-landing-proxy.conf;
        proxy_intercept_errors on;
        error_page 404 502 503 504 = @aplicacion;
    }
    location ~ ^/software-para-[a-z0-9-]+/?$ {
        include /etc/nginx/snippets/agendauno-landing-proxy.conf;
        proxy_intercept_errors on;
        error_page 404 502 503 504 = @aplicacion;
    }
    location = /sitemap.xml {
        include /etc/nginx/snippets/agendauno-landing-proxy.conf;
    }
    location = /robots.txt {
        include /etc/nginx/snippets/agendauno-landing-proxy.conf;
    }
    location ^~ /assets-turnouno/ {
        include /etc/nginx/snippets/agendauno-landing-proxy.conf;
    }

    location @aplicacion {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/agendauno-cabeceras.conf;
        try_files /app.html =404;
    }
    location / {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/agendauno-cabeceras.conf;
        try_files $uri /app.html;
    }
}

# Subdominio de cada negocio ({slug}.agendauno.mx, {slug}.turnouno.mx) y cualquier otro
# host: siempre la aplicación, también en "/". La API resuelve el negocio por el
# subdominio y solo lo abre en el dominio de su producto.
server {
    listen 80 default_server;
    server_name *.${DOMINIO} *.${DOMINIO_TURNOUNO} _;
    root /usr/share/nginx/html/app;
    include /etc/nginx/snippets/agendauno-comun.conf;

    # El HTML se revalida siempre (ver arriba).
    location / {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/agendauno-cabeceras.conf;
        try_files /app.html =404;
    }
}
